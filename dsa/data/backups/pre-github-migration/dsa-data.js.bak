ck","number":14,"slug":"stack","title":"Stack","category":"Linear Data Structures","description":"LIFO structure, parenthesis validation, infix/postfix evaluation, min-stack, and expression parsing.","iconName":"Layers","totalProblems":75,"easyCount":25,"mediumCount":35,"hardCount":15},{"id":"15-queue","number":15,"slug":"queue","title":"Queue","category":"Linear Data Structures","description":"FIFO buffers, circular queues, queue using stacks, sliding window stream, and process scheduling.","iconName":"AlignJustify","totalProblems":75,"easyCount":25,"mediumCount":35,"hardCount":15},{"id":"16-deque","number":16,"slug":"deque","title":"Deque","category":"Linear Data Structures","description":"Double-ended queues, sliding window maximums, palindromic checks, and work-stealing buffers.","iconName":"Split","totalProblems":75,"easyCount":25,"mediumCount":35,"hardCount":15},{"id":"17-monotonic-stack-queue","number":17,"slug":"monotonic-stack-queue","title":"Monotonic Stack & Queue","category":"Linear Data Structures","description":"Next greater element, largest rectangle in histogram, daily temperatures, and maximal rectangle.","iconName":"BarChart2","totalProblems":75,"easyCount":25,"mediumCount":35,"hardCount":15},{"id":"18-binary-search","number":18,"slug":"binary-search","title":"Binary Search","category":"Algorithms","description":"Search on sorted ranges, search in rotated array, binary search on answers, lower/upper bounds.","iconName":"Crosshair","totalProblems":75,"easyCount":25,"mediumCount":35,"hardCount":15},{"id":"19-bit-manipulation","number":19,"slug":"bit-manipulation","title":"Bit Manipulation","category":"Fundamentals","description":"Bitwise AND/OR/XOR/NOT, bitmasks, Brian Kernighan algorithm, subsets generation, and single number.","iconName":"Cpu","totalProblems":75,"easyCount":25,"mediumCount":35,"hardCount":15},{"id":"20-greedy","number":20,"slug":"greedy","title":"Greedy Algorithms","category":"Algorithms","description":"Activity selection, fraction