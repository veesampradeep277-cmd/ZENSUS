t":"34 19\n","expectedOutput":"53\n","label":"Sample 1"},{"id":"v2","input":"68 57\n","expectedOutput":"125\n","label":"Sample 2"}],"starterCode":{"python":"import sys\n\ndef solve():\n    # Read standard input\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    \n    # Write your solution here\n    pass\n\nif __name__ == \"__main__\":\n    solve()\n","cpp":"#include <iostream>\n#include <vector>\n#include <string>\n#include <algorithm>\n\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    // Read input and write solution here\n\n    return 0;\n}\n","java":"import java.io.*;\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        Scanner sc = new Scanner(System.in);\n        // Read input and write solution here\n    }\n}\n","javascript":"'use strict';\n\nconst fs = require('fs');\n\nfunction solve() {\n    const input = fs.readFileSync(0, 'utf8').trim();\n    if (!input) return;\n    const tokens = input.split(/\\s+/);\n    \n    // Write your solution here\n}\n\nsolve();\n"},"timeLimitMs":2000,"memoryLimitMb":256,"hiddenTests":[{"id":"h1","input":"102 76\n","expectedOutput":"178\n","isHidden":true},{"id":"h2","input":"0 0\n","expectedOutput":"0\n","isHidden":true},{"id":"h3","input":"340 190\n","expectedOutput":"530\n","isHidden":true}]},"13-linked-list-075":{"id":"13-linked-list-075","topicId":"13-linked-list","topicTitle":"Linked List","order":75,"title":"Add Two Numbers Linked (Variant 15)","difficulty":"Hard","progressionStage":"Interview / Placement","tags":["Linked List","Stage-5"],"executionType":"stdin","description":"Given input parameters for add two numbers linked (variant 15), compute and print the required algorithmic output according to the problem constraints. Read inputs from standard input and write the exact output to standard output.","inputFormat":"The input consists of space-separated tokens corresponding to test case parameters.","outputFormat":"Print the computed result on a single line.","constraints":["1 <= N <= 100000","-10^9 <= A[i] <= 10^9"],"examples":[{"input":"35 20","output":"55","explanation":"For input (35 20), the computed result is 55."},{"input":"70 60","output":"130","explanation":"For input (70 60), the computed result is 130."}],"visibleTests":[{"id":"v1","input":"35 20\n","expectedOutput":"55\n","label":"Sample 1"},{"id":"v2","input":"70 60\n","expectedOutput":"130\n","label":"Sample 2"}],"starterCode":{"python":"import sys\n\ndef solve():\n    # Read standard input\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    \n    # Write your solution here\n    pass\n\nif __name__ == \"__main__\":\n    solve()\n","cpp":"#include <iostream>\n#include <vector>\n#include <string>\n#include <algorithm>\n\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    // Read input and write solution here\n\n    return 0;\n}\n","java":"import java.io.*;\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        Scanner sc = new Scanner(System.in);\n        // Read input and write solution here\n    }\n}\n","javascript":"'use strict';\n\nconst fs = require('fs');\n\nfunction solve() {\n    const input = fs.readFileSync(0, 'utf8').trim();\n    if (!input) return;\n    const tokens = input.split(/\\s+/);\n    \n    // Write your solution here\n}\n\nsolve();\n"},"timeLimitMs":2000,"memoryLimitMb":256,"hiddenTests":[{"id":"h1","input":"105 80\n","expectedOutput":"185\n","isHidden":true},{"id":"h2","input":"0 0\n","expectedOutput":"0\n","isHidden":true},{"id":"h3","input":"350 200\n","expectedOutput":"550\n","isHidden":true}]},"14-stack-001":{"id":"14-stack-001","topicId":"14-stack","topicTitle":"Stack","order":1,"title":"Valid Parentheses String","difficulty":"Easy","progressionStage":"Foundation","tags":["Stack","Matching","Strings"],"executionType":"stdin","description":"Given a string $S$ containing just the characters \"(\", \")\", \"{\", \"}\", \"[\" and \"]\", determine if the input string is valid. An input string is valid if open brackets are closed by the same type of brackets in the correct order. Output \"YES\" if valid, otherwise \"NO\".","inputFormat":"A single string $S$ containing brackets.","outputFormat":"Print \"YES\" if valid, else \"NO\".","constraints":["1 <= |S| <= 100000","S consists only of ()[]{} brackets."],"examples":[{"input":"()[]{}","output":"YES","explanation":"All brackets match correctly."},{"input":"(]","output":"NO","explanation":"Round open bracket closed by square bracket."}],"visibleTests":[{"id":"v1","input":"()[]{}\n","expectedOutput":"YES\n","label":"All Pairs"},{"id":"v2","input":"(]\n","expectedOutput":"NO\n","label":"Mismatched"},{"id":"v3","input":"([{}])\n","expectedOutput":"YES\n","label":"Nested"}],"starterCode":{"python":"import sys\n\ndef solve():\n    s = sys.stdin.read().strip()\n    if not s:\n        print(\"YES\")\n        return\n    stack = []\n    mapping = {')': '(', '}': '{', ']': '['}\n    for char in s:\n        if char in mapping:\n            top = stack.pop() if stack else '#'\n            if mapping[char] != top:\n                print(\"NO\")\n                return\n        else:\n            stack.append(char)\n    print(\"YES\" if not stack else \"NO\")\n\nif __name__ == \"__main__\":\n    solve()\n","cpp":"#include <iostream>\n#include <string>\n#include <stack>\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    string s;\n    if (cin >> s) {\n        stack<char> st;\n        bool ok = true;\n        for (char c : s) {\n            if (c == '(' || c == '{' || c == '[') st.push(c);\n            else {\n                if (st.empty()) { ok = false; break; }\n                char top = st.top(); st.pop();\n                if (c == ')' && top != '(') { ok = false; break; }\n                if (c == '}' && top != '{') { ok = false; break; }\n                if (c == ']' && top != '[') { ok = false; break; }\n            }\n        }\n        if (!st.empty()) ok = false;\n        cout << (ok ? \"YES\" : \"NO\") << \"\\n\";\n    }\n    return 0;\n}\n","java":"import java.util.Scanner;\nimport java.util.Stack;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNext()) {\n            String s = sc.next();\n            Stack<Character> st = new Stack<>();\n            boolean ok = true;\n            for (char c : s.toCharArray()) {\n                if (c == '(' || c == '{' || c == '[') st.push(c);\n                else {\n                    if (st.isEmpty()) { ok = false; break; }\n                    char top = st.pop();\n                    if (c == ')' && top != '(') { ok = false; break; }\n                    if (c == '}' && top != '{') { ok = false; break; }\n                    if (c == ']' && top != '[') { ok = false; break; }\n                }\n            }\n            if (!st.isEmpty()) ok = false;\n            System.out.println(ok ? \"YES\" : \"NO\");\n        }\n    }\n}\n","javascript":"'use strict';\nconst fs = require('fs');\n\nfunction solve() {\n    const s = fs.readFileSync(0, 'utf8').trim();\n    if (!s) { console.log('YES'); return; }\n    const map = { ')': '(', '}': '{', ']': '[' };\n    const stack = [];\n    for (let c of s) {\n        if (c in map) {\n            if (stack.length === 0 || stack.pop() !== map[c]) {\n                console.log('NO');\n                return;\n            }\n        } else {\n            stack.push(c);\n        }\n    }\n    console.log(stack.length === 0 ? 'YES' : 'NO');\n}\n\nsolve();\n"},"timeLimitMs":2000,"memoryLimitMb":256,"hiddenTests":[{"id":"h1","input":"(\n","expectedOutput":"NO\n","isHidden":true},{"id":"h2","input":"]\n","expectedOutput":"NO\n","isHidden":true},{"id":"h3","input":"((()))\n","expectedOutput":"YES\n","isHidden":true},{"id":"h4","input":"[(])\n","expectedOutput":"NO\n","isHidden":true}]},"14-stack-002":{"id":"14-stack-002","topicId":"14-stack","topicTitle":"Stack","order":2,"title":"Min Stack Constant Time","difficulty":"Easy","progressionStage":"Foundation","tags":["Stack","Stage-1"],"executionType":"stdin","description":"Given input parameters for min stack constant time, compute and print the required algorithmic output according to the problem constraints. Read inputs from standard input and write the exact output to standard output.","inputFormat":"The input consists of space-separated tokens corresponding to test case parameters.","outputFormat":"Print the computed result on a single line.","constraints":["1 <= N <= 100000","-10^9 <= A[i] <= 10^9"],"examples":[{"input":"32 7","output":"39","explanation":"For input (32 7), the computed result is 39."},{"input":"64 21","output":"85","explanation":"For input (64 21), the computed result is 85."}],"visibleTests":[{"id":"v1","input":"32 7\n","expectedOutput":"39\n","label":"Sample 1"},{"id":"v2","input":"64 21\n","expectedOutput":"85\n","label":"Sample 2"}],"starterCode":{"python":"import sys\n\ndef solve():\n    # Read standard input\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    \n    # Write your solution here\n    pass\n\nif __name__ == \"__main__\":\n    solve()\n","cpp":"#include <iostream>\n#include <vector>\n#include <string>\n#include <algorithm>\n\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    // Read input and write solution here\n\n    return 0;\n}\n","java":"import java.io.*;\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        Scanner sc = new Scanner(System.in);\n        // Read input and write solution here\n    }\n}\n","javascript":"'use strict';\n\nconst fs = require('fs');\n\nfunction solve() {\n    const input = fs.readFileSync(0, 'utf8').trim();\n    if (!input) return;\n    const tokens = input.split(/\\s+/);\n    \n    // Write your solution here\n}\n\nsolve();\n"},"timeLimitMs":2000,"memoryLimitMb":256,"hiddenTests":[{"id":"h1","input":"96 28\n","expectedOutput":"124\n","isHidden":true},{"id":"h2","input":"0 0\n","expectedOutput":"0\n","isHidden":true},{"id":"h3","input":"320 70\n","expectedOutput":"390\n","isHidden":true}]},"14-stack-003":{"id":"14-stack-003","topicId":"14-stack","topicTitle":"Stack","order":3,"title":"Evaluate Reverse Polish Notation","difficulty":"Easy","progressionStage":"Foundation","tags":["Stack","Stage-1"],"executionType":"stdin","description":"Given input parameters for evaluate reverse polish notation, compute and print the required algorithmic output according to the problem constraints. Read inputs from standard input and write the exact output to standard output.","inputFormat":"The input consists of space-separated tokens corresponding to test case parameters.","outputFormat":"Print the computed result on a single line.","constraints":["1 <= N <= 100000","-10^9 <= A[i] <= 10^9"],"examples":[{"input":"33 8","output":"41","explanation":"For input (33 8), the computed result is 41."},{"input":"66 24","output":"90","explanation":"For input (66 24), the computed result is 90."}],"visibleTests":[{"id":"v1","input":"33 8\n","expectedOutput":"41\n","label":"Sample 1"},{"id":"v2","input":"66 24\n","expectedOutput":"90\n","label":"Sample 2"}],"starterCode":{"python":"import sys\n\ndef solve():\n    # Read standard input\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    \n    # Write your solution here\n    pass\n\nif __name__ == \"__main__\":\n    solve()\n","cpp":"#include <iostream>\n#include <vector>\n#include <string>\n#include <algorithm>\n\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    // Read input and write solution here\n\n    return 0;\n}\n","j