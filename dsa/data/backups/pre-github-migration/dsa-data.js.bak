main(String[] args) throws Exception {\n        Scanner sc = new Scanner(System.in);\n        // Read input and write solution here\n    }\n}\n","javascript":"'use strict';\n\nconst fs = require('fs');\n\nfunction solve() {\n    const input = fs.readFileSync(0, 'utf8').trim();\n    if (!input) return;\n    const tokens = input.split(/\\s+/);\n    \n    // Write your solution here\n}\n\nsolve();\n"},"timeLimitMs":2000,"memoryLimitMb":256,"hiddenTests":[{"id":"h1","input":"45 80\n","expectedOutput":"125\n","isHidden":true},{"id":"h2","input":"0 0\n","expectedOutput":"0\n","isHidden":true},{"id":"h3","input":"150 200\n","expectedOutput":"350\n","isHidden":true}]},"03-arrays-001":{"id":"03-arrays-001","topicId":"03-arrays","topicTitle":"Arrays","order":1,"title":"Find the Largest Element","difficulty":"Easy","progressionStage":"Foundation","tags":["Arrays","Traversal","Linear Scan"],"executionType":"stdin","description":"Given an array $A$ of $N$ integers, find and print the maximum element in the array.","inputFormat":"The first line contains integer $N$. The second line contains $N$ space-separated integers $A[0], A[1], \\dots, A[N-1]$.","outputFormat":"Print the largest integer present in the array.","constraints":["1 <= N <= 100000","-10^9 <= A[i] <= 10^9"],"examples":[{"input":"5\n1 8 7 56 90","output":"90","explanation":"90 is the greatest integer in the array."},{"input":"4\n-10 -5 -20 -1","output":"-1","explanation":"-1 is the greatest integer in the negative array."}],"visibleTests":[{"id":"v1","input":"5\n1 8 7 56 90\n","expectedOutput":"90\n","label":"Example 1"},{"id":"v2","input":"4\n-10 -5 -20 -1\n","expectedOutput":"-1\n","label":"Negative Numbers"},{"id":"v3","input":"1\n42\n","expectedOutput":"42\n","label":"Single Element"}],"starterCode":{"python":"import sys\n\ndef solve():\n    tokens = sys.stdin.read().split()\n    if not tokens:\n        return\n    n = int(tokens[0])\n    arr = [int(x) for x in tokens[1:n+1]]\n    \n    # Write code to find and print the maximum element\n    max_val = max(arr)\n    print(max_val)\n\nif __name__ == \"__main__\":\n    solve()\n","cpp":"#include <iostream>\n#include <vector>\n#include <algorithm>\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n;\n    if (cin >> n) {\n        vector<long long> arr(n);\n        for (int i = 0; i < n; i++) cin >> arr[i];\n        \n        long long max_val = arr[0];\n        for (int i = 1; i < n; i++) {\n            if (arr[i] > max_val) max_val = arr[i];\n        }\n        cout << max_val << \"\\n\";\n    }\n    return 0;\n}\n","java":"import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            long maxVal = sc.nextLong();\n            for (int i = 1; i < n; i++) {\n                long val = sc.nextLong();\n                if (val > maxVal) maxVal = val;\n            }\n            System.out.println(maxVal);\n        }\n    }\n}\n","javascript":"'use strict';\nconst fs = require('fs');\n\nfunction solve() {\n    const input = fs.readFileSync(0, 'utf8').trim();\n    if (!input) return;\n    const tokens = input.split(/\\s+/);\n    const n = parseInt(tokens[0], 10);\n    let maxVal = BigInt(tokens[1]);\n    for (let i = 2; i <= n; i++) {\n        const val = BigInt(tokens[i]);\n        if (val > maxVal) maxVal = val;\n    }\n    console.log(maxVal.toString());\n}\n\nsolve();\n"},"timeLimitMs":2000,"memoryLimitMb":256,"hiddenTests":[{"id":"h1","input":"6\n100 200 50 400 300 250\n","expectedOutput":"400\n","isHidden":true},{"id":"h2","input":"5\n-999999999 -888888888 -777777777 -1000000000 -666666666\n","expectedOutput":"-666666666\n","isHidden":true},{"id":"h3","input":"7\n0 0 0 0 0 0 0\n","expectedOutput":"0\n","isHidden":true},{"id":"h4","input":"4\n10 10 10 10\n","expectedOutput":"10\n","isHidden":true}]},"03-arrays-002":{"id":"03-arrays-002","topicId":"03-arrays","topicTitle":"Arrays","order":2,"title":"Reverse an Array","difficulty":"Easy","progressionStage":"Foundation","tags":["Arrays","Two Pointers","In-place"],"executionType":"stdin","description":"Given an array $A$ of $N$ integers, reverse the array in place and print the reversed elements.","inputFormat":"First line contains integer $N$. Second line contains $N$ space-separated integers.","outputFormat":"Print the elements in reversed order, separated by spaces.","constraints":["1 <= N <= 100000","-10^9 <= A[i] <= 10^9"],"examples":[{"input":"4\n1 2 3 4","output":"4 3 2 1","explanation":"Reversing [1, 2, 3, 4] gives [4, 3, 2, 1]."},{"input":"3\n10 20 30","output":"30 20 10","explanation":"Reversing [10, 20, 30] gives [30, 20, 10]."}],"visibleTests":[{"id":"v1","input":"4\n1 2 3 4\n","expectedOutput":"4 3 2 1\n","label":"Example 1"},{"id":"v2","input":"3\n10 20 30\n","expectedOutput":"30 20 10\n","label":"Example 2"},{"id":"v3","input":"1\n99\n","expectedOutput":"99\n","label":"Single Element"}],"starterCode":{"python":"import sys\n\ndef solve():\n    tokens = sys.stdin.read().split()\n    if not tokens:\n        return\n    n = int(tokens[0])\n    arr = tokens[1:n+1]\n    \n    # Reverse and print\n    print(\" \".join(reversed(arr)))\n\nif __name__ == \"__main__\":\n    solve()\n","cpp":"#include <iostream>\n#include <vector>\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n;\n    if (cin >> n) {\n        vector<long long> arr(n);\n        for (int i = 0; i < n; i++) cin >> arr[i];\n        for (int i = n - 1; i >= 0; i--) {\n            cout << arr[i] << (i == 0 ? \"\" : \" \");\n        }\n        cout << \"\\n\";\n    }\n    return 0;\n}\n","java":"import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            long[] arr = new long[n];\n            for (int i = 0; i < n; i++) arr[i] = sc.nextLong();\n            for (int i = n - 1; i >= 0; i--) {\n                System.out.print(arr[i] + (i == 0 ? \"\" : \" \"));\n            }\n            System.out.println();\n        }\n    }\n}\n","javascript":"'use strict';\nconst fs = require('fs');\n\nfunction solve() {\n    const input = fs.readFileSync(0, 'utf8').trim();\n    if (!input) return;\n    const tokens = input.split(/\\s+/);\n    const n = parseInt(tokens[0], 10);\n    const arr = tokens.slice(1, n + 1);\n    console.log(arr.reverse().join(' '));\n}\n\nsolve();\n"},"timeLimitMs":2000,"memoryLimitMb":256,"hiddenTests":[{"id":"h1","input":"5\n5 4 3 2 1\n","expectedOutput":"1 2 3 4 5\n","isHidden":true},{"id":"h2","input":"2\n-10 10\n","expectedOutput":"10 -10\n","isHidden":true},{"id":"h3","input":"6\n1 1 2 2 3 3\n","expectedOutput":"3 3 2 2 1 1\n","isHidden":true}]},"03-arrays-003":{"id":"03-arrays-003","topicId":"03-arrays","topicTitle":"Arrays","order":3,"title":"Dutch National Flag Partition","difficulty":"Easy","progressionStage":"Foundation","tags":["Arrays","Stage-1"],"executionType":"stdin","description":"Given input parameters for dutch national flag partition, compute and print the required algorithmic output according to the problem constraints. Read inputs from standard input and write the exact output to standard output.","inputFormat":"The input consists of space-separated tokens corresponding to test case parameters.","outputFormat":"Print the computed result on a single line.","constraints":["1 <= N <= 100000","-10^9 <= A[i] <= 10^9"],"examples":[{"input":"13 8","output":"21","explanation":"For input (13 8), the computed result is 21."},{"input":"26 24","output":"50","explanation":"For input (26 24), the computed result is 50."}],"visibleTests":[{"id":"v1","input":"13 8\n","expectedOutput":"21\n","label":"Sample 1"},{"id":"v2","input":"26 24\n","expectedOutput":"50\n","label":"Sample 2"}],"starterCode":