<string>\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    string s;\n    if (cin >> s) {\n        bool ok = true;\n        int l = 0, r = s.size() - 1;\n        while (l < r) {\n            if (s[l] != s[r]) { ok = false; break; }\n            l++; r--;\n        }\n        cout << (ok ? \"YES\" : \"NO\") << \"\\n\";\n    }\n    return 0;\n}\n","java":"import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNext()) {\n            String s = sc.next();\n            int l = 0, r = s.length() - 1;\n            boolean ok = true;\n            while (l < r) {\n                if (s.charAt(l) != s.charAt(r)) { ok = false; break; }\n                l++; r--;\n            }\n            System.out.println(ok ? \"YES\" : \"NO\");\n        }\n    }\n}\n","javascript":"'use strict';\nconst fs = require('fs');\n\nfunction solve() {\n    const s = fs.readFileSync(0, 'utf8').trim();\n    if (!s) return;\n    const rev = s.split('').reverse().join('');\n    console.log(s === rev ? 'YES' : 'NO');\n}\n\nsolve();\n"},"timeLimitMs":2000,"memoryLimitMb":256,"hiddenTests":[{"id":"h1","input":"a\n","expectedOutput":"YES\n","isHidden":true},{"id":"h2","input":"ab\n","expectedOutput":"NO\n","isHidden":true},{"id":"h3","input":"madam\n","expectedOutput":"YES\n","isHidden":true},{"id":"h4","input":"algorithmic\n","expectedOutput":"NO\n","isHidden":true}]},"04-strings-002":{"id":"04-strings-002","topicId":"04-strings","topicTitle":"Strings","order":2,"title":"Count Vowels and Consonants","difficulty":"Easy","progressionStage":"Foundation","tags":["Strings","Frequency","Character Classification"],"executionType":"stdin","description":"Given a lowercase string $S$, count the number of vowels (a, e, i, o, u) and consonants.","inputFormat":"A single string $S$ containing lowercase English letters.","outputFormat":"Print two space-separated integers: the count of vowels followed by the count of consonants.","constraints":["1 <= |S| <= 100000","S consists only of lowercase letters."],"examples":[{"input":"hello","output":"2 3","explanation":"Vowels: e, o (2). Consonants: h, l, l (3)."},{"input":"aeiou","output":"5 0","explanation":"All characters are vowels."}],"visibleTests":[{"id":"v1","input":"hello\n","expectedOutput":"2 3\n","label":"Example 1"},{"id":"v2","input":"aeiou\n","expectedOutput":"5 0\n","label":"All Vowels"}],"starterCode":{"python":"import sys\n\ndef solve():\n    s = sys.stdin.read().strip()\n    if not s:\n        return\n    vowels = set('aeiou')\n    v_count = sum(1 for c in s if c in vowels)\n    c_count = len(s) - v_count\n    print(f\"{v_count} {c_count}\")\n\nif __name__ == \"__main__\":\n    solve()\n","cpp":"#include <iostream>\n#include <string>\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    string s;\n    if (cin >> s) {\n        int v = 0, c = 0;\n        for (char ch : s) {\n            if (ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u') v++;\n            else c++;\n        }\n        cout << v << \" \" << c << \"\\n\";\n    }\n    return 0;\n}\n","java":"import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNext()) {\n            String s = sc.next();\n            int v = 0, c = 0;\n            for (char ch : s.toCharArray()) {\n                if (\"aeiou\".indexOf(ch) >= 0) v++;\n                else c++;\n            }\n            System.out.println(v + \" \" + c);\n        }\n    }\n}\n","javascript":"'use strict';\nconst fs = require('fs');\n\nfunction solve() {\n    const s = fs.readFileSync(0, 'utf8').trim();\n    if (!s) return;\n    const v = (s.match(/[aeiou]/g) || []).length;\n    const c = s.length - v;\n    console.log(v + ' ' + c);\n}\n\nsolve();\n"},"timeLimitMs":2000,"memoryLimitMb":2