 {\n    public static void main(String[] args) throws Exception {\n        Scanner sc = new Scanner(System.in);\n        // Read input and write solution here\n    }\n}\n","javascript":"'use strict';\n\nconst fs = require('fs');\n\nfunction solve() {\n    const input = fs.readFileSync(0, 'utf8').trim();\n    if (!input) return;\n    const tokens = input.split(/\\s+/);\n    \n    // Write your solution here\n}\n\nsolve();\n"},"timeLimitMs":2000,"memoryLimitMb":256,"hiddenTests":[{"id":"h1","input":"75 80\n","expectedOutput":"155\n","isHidden":true},{"id":"h2","input":"0 0\n","expectedOutput":"0\n","isHidden":true},{"id":"h3","input":"250 200\n","expectedOutput":"450\n","isHidden":true}]},"07-searching-001":{"id":"07-searching-001","topicId":"07-searching","topicTitle":"Searching","order":1,"title":"Linear Search Target","difficulty":"Easy","progressionStage":"Foundation","tags":["Searching","Linear Scan"],"executionType":"stdin","description":"Given an array $A$ of $N$ integers and a target value $K$, find the 0-based index of the first occurrence of $K$. If $K$ is not present, print -1.","inputFormat":"First line contains two integers $N$ and $K$. Second line contains $N$ space-separated integers.","outputFormat":"Print the 0-based index of $K$, or -1 if not found.","constraints":["1 <= N <= 100000","-10^9 <= A[i], K <= 10^9"],"examples":[{"input":"5 7\n1 2 7 4 5","output":"2","explanation":"7 first appears at index 2."},{"input":"4 99\n1 2 3 4","output":"-1","explanation":"99 does not appear in the array."}],"visibleTests":[{"id":"v1","input":"5 7\n1 2 7 4 5\n","expectedOutput":"2\n","label":"Target Present"},{"id":"v2","input":"4 99\n1 2 3 4\n","expectedOutput":"-1\n","label":"Target Absent"}],"starterCode":{"python":"import sys\n\ndef solve():\n    tokens = sys.stdin.read().split()\n    if not tokens:\n        return\n    n = int(tokens[0])\n    k = int(tokens[1])\n    arr = [int(x) for x in tokens[2:2+n]]\n    \n    try:\n        idx = arr.index(k)\n        print(idx)\n    except ValueError:\n        print(-1)\n\nif __name__ == \"__main__\":\n    solve()\n","cpp":"#include <iostream>\n#include <vector>\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n;\n    long long k;\n    if (cin >> n >> k) {\n        int ans = -1;\n        for (int i = 0; i < n; i++) {\n            long long x;\n            cin >> x;\n            if (x == k && ans == -1) ans = i;\n        }\n        cout << ans << \"\\n\";\n    }\n    return 0;\n}\n","java":"import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            long k = sc.nextLong();\n            int ans = -1;\n            for (int i = 0; i < n; i++) {\n                long x = sc.nextLong();\n                if (x == k && ans == -1) ans = i;\n            }\n            System.out.println(ans);\n        }\n    }\n}\n","javascript":"'use strict';\nconst fs = require('fs');\n\nfunction solve() {\n    const input = fs.readFileSync(0, 'utf8').trim();\n    if (!input) return;\n    const tokens = input.split(/\\s+/);\n    const n = parseInt(tokens[0], 10);\n    const k = tokens[1];\n    let ans = -1;\n    for (let i = 0; i < n; i++) {\n        if (tokens[2 + i] === k) { ans = i; break; }\n    }\n    console.log(ans);\n}\n\nsolve();\n"},"timeLimitMs":2000,"memoryLimitMb":256,"hiddenTests":[{"id":"h1","input":"1 42\n42\n","expectedOutput":"0\n","isHidden":true},{"id":"h2","input":"6 10\n10 10 10 10 10 10\n","expectedOutput":"0\n","isHidden":true},{"id":"h3","input":"5 -5\n1 2 -5 4 -5\n","expectedOutput":"2\n","isHidden":true}]},"07-searching-002":{"id":"07-searching-002","topicId":"07-searching","topicTitle":"Searching","order":2,"title":"Square Root Floor","difficulty":"Easy","progressionStage":"Foundation","tags":["Searching","Stage-1"],"executionType":"stdin","description":"Given input