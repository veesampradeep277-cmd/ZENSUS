\n    \n    # Write your solution here\n    pass\n\nif __name__ == \"__main__\":\n    solve()\n","cpp":"#include <iostream>\n#include <vector>\n#include <string>\n#include <algorithm>\n\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    // Read input and write solution here\n\n    return 0;\n}\n","java":"import java.io.*;\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        Scanner sc = new Scanner(System.in);\n        // Read input and write solution here\n    }\n}\n","javascript":"'use strict';\n\nconst fs = require('fs');\n\nfunction solve() {\n    const input = fs.readFileSync(0, 'utf8').trim();\n    if (!input) return;\n    const tokens = input.split(/\\s+/);\n    \n    // Write your solution here\n}\n\nsolve();\n"},"timeLimitMs":2000,"memoryLimitMb":256,"hiddenTests":[{"id":"h1","input":"45 80\n","expectedOutput":"125\n","isHidden":true},{"id":"h2","input":"0 0\n","expectedOutput":"0\n","isHidden":true},{"id":"h3","input":"150 200\n","expectedOutput":"350\n","isHidden":true}]},"18-binary-search-001":{"id":"18-binary-search-001","topicId":"18-binary-search","topicTitle":"Binary Search","order":1,"title":"Binary Search in Sorted Array","difficulty":"Easy","progressionStage":"Foundation","tags":["Binary Search","Divide and Conquer"],"executionType":"stdin","description":"Given a sorted array $A$ of $N$ distinct integers in ascending order and a target value $K$, write a function to search $K$ in $A$. If $K$ exists, return its 0-based index. Otherwise, print -1. Your solution must run in $O(\\log N)$ runtime complexity.","inputFormat":"First line contains two integers $N$ and $K$. Second line contains $N$ sorted integers.","outputFormat":"Print the 0-based index of $K$ in array $A$, or -1 if $K$ is not found.","constraints":["1 <= N <= 100000","-10^9 <= A[i], K <= 10^9","All elements in A are strictly ascending."],"examples":[{"input":"6 9\n-1 0 3 5 9 12","output":"4","explanation":"9 exists in A and its index is 4."},{"input":"6 2\n-1 0 3 5 9 12","output":"-1","explanation":"2 does not exist in A so return -1."}],"visibleTests":[{"id":"v1","input":"6 9\n-1 0 3 5 9 12\n","expectedOutput":"4\n","label":"Present"},{"id":"v2","input":"6 2\n-1 0 3 5 9 12\n","expectedOutput":"-1\n","label":"Absent"}],"starterCode":{"python":"import sys\n\ndef solve():\n    tokens = sys.stdin.read().split()\n    if not tokens:\n        return\n    n = int(tokens[0])\n    k = int(tokens[1])\n    arr = [int(x) for x in tokens[2:2+n]]\n    \n    l, r = 0, n - 1\n    ans = -1\n    while l <= r:\n        mid = (l + r) // 2\n        if arr[mid] == k:\n            ans = mid\n            break\n        elif arr[mid] < k:\n            l = mid + 1\n        else:\n            r = mid - 1\n            \n    print(ans)\n\nif __name__ == \"__main__\":\n    solve()\n","cpp":"#include <iostream>\n#include <vector>\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    int n;\n    long long k;\n    if (cin >> n >> k) {\n        vector<long long> arr(n);\n        for (int i = 0; i < n; i++) cin >> arr[i];\n\n        int l = 0, r = n - 1, ans = -1;\n        while (l <= r) {\n            int mid = l + (r - l) / 2;\n            if (arr[mid] == k) { ans = mid; break; }\n            else if (arr[mid] < k) l = mid + 1;\n            else r = mid - 1;\n        }\n        cout << ans << \"\\n\";\n    }\n    return 0;\n}\n","java":"import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextInt()) {\n            int n = sc.nextInt();\n            long k = sc.nextLong();\n            long[] arr = new long[n];\n            for (int i = 0; i < n; i++) arr[i] = sc.nextLong();\n\n            int l = 0, r = n - 1, ans = -1;\n            while (l <= r) {\n                int mid = l + (r - l) / 2;\n                if (arr[mid] == k) { ans = mid; break; }\n                else if (arr[mid] < k) l = mid + 1;\n                else r = mid - 1;\n            }\n            System.out.println(ans);\n        }\n    }\n}\n","javascript":"'use strict';\nconst fs = require('fs');\n\nfunction solve() {\n    const input = fs.readFileSync(0, 'utf8').trim();\n    if (!input) return;\n    const tokens = input.split(/\\s+/);\n    const n = parseInt(tokens[0], 10);\n    const k = BigInt(tokens[1]);\n    const arr = tokens.slice(2, 2 + n).map(x => BigInt(x));\n\n    let l = 0, r = n - 1, ans = -1;\n    while (l <= r) {\n        const mid = Math.floor((l + r) / 2);\n        if (arr[mid] === k) { ans = mid; break; }\n        else if (arr[mid] < k) l = mid + 1;\n        else r = mid - 1;\n    }\n    console.log(ans);\n}\n\nsolve();\n"},"timeLimitMs":2000,"memoryLimitMb":256,"hiddenTests":[{"id":"h1","input":"1 5\n5\n","expectedOutput":"0\n","isHidden":true},{"id":"h2","input":"1 3\n5\n","expectedOutput":"-1\n","isHidden":true},{"id":"h3","input":"5 100\n10 20 30 40 100\n","expectedOutput":"4\n","isHidden":true},{"id":"h4","input":"5 10\n10 20 30 40 100\n","expectedOutput":"0\n","isHidden":true}]},"18-binary-search-002":{"id":"18-binary-search-002","topicId":"18-binary-search","topicTitle":"Binary Search","order":2,"title":"Koko Eating Bananas Speed","difficulty":"Easy","progressionStage":"Foundation","tags":["Binary Search","Stage-1"],"executionType":"stdin","description":"Given input parameters for koko eating bananas speed, compute and print the required algorithmic output according to the problem constraints. Read inputs from standard input and write the exact output to standard output.","inputFormat":"The input consists of space-separated tokens corresponding to test case parameters.","outputFormat":"Print the computed result on a single line.","constraints":["1 <= N <= 100000","-10^9 <= A[i] <= 10^9"],"examples":[{"input":"12 7","output":"19","explanation":"For input (12 7), the computed result is 