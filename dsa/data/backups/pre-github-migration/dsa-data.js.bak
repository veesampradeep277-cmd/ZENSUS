mixed-interview-patterns-072","topicId":"41-mixed-interview-patterns","topicTitle":"Mixed DSA / Interview Patterns","order":72,"title":"Trapping Rain Water II 2D (Variant 14)","difficulty":"Hard","progressionStage":"Interview / Placement","tags":["Mixed DSA / Interview Patterns","Stage-5"],"executionType":"stdin"},{"id":"41-mixed-interview-patterns-073","topicId":"41-mixed-interview-patterns","topicTitle":"Mixed DSA / Interview Patterns","order":73,"title":"Median of Running Numbers (Variant 14)","difficulty":"Hard","progressionStage":"Interview / Placement","tags":["Mixed DSA / Interview Patterns","Stage-5"],"executionType":"stdin"},{"id":"41-mixed-interview-patterns-074","topicId":"41-mixed-interview-patterns","topicTitle":"Mixed DSA / Interview Patterns","order":74,"title":"Sliding Window Median Hard (Variant 14)","difficulty":"Hard","progressionStage":"Interview / Placement","tags":["Mixed DSA / Interview Patterns","Stage-5"],"executionType":"stdin"},{"id":"41-mixed-interview-patterns-075","topicId":"41-mixed-interview-patterns","topicTitle":"Mixed DSA / Interview Patterns","order":75,"title":"Minimum Window Subsequence (Variant 15)","difficulty":"Hard","progressionStage":"Interview / Placement","tags":["Mixed DSA / Interview Patterns","Stage-5"],"executionType":"stdin"}]},"problemsById":{"01-input-output-001":{"id":"01-input-output-001","topicId":"01-input-output","topicTitle":"Input & Output","order":1,"title":"Sum of Two Integers","difficulty":"Easy","progressionStage":"Foundation","tags":["Input/Output","Arithmetic","Basics"],"executionType":"stdin","description":"Read two integers $A$ and $B$ from standard input and print their sum to standard output.","inputFormat":"A single line containing two space-separated integers $A$ and $B$.","outputFormat":"Print a single integer representing $A + B$.","constraints":["-10^9 <= A, B <= 10^9"],"examples":[{"input":"5 7","output":"12","explanation":"5 + 7 = 12"},{"input":"-3 8","output":"5","explanation":"-3 + 8 = 5"}],"visibleTests":[{"id":"v1","input":"5 7\n","expectedOutput":"12\n","label":"Example 1"},{"id":"v2","input":"-3 8\n","expectedOutput":"5\n","label":"Example 2"},{"id":"v3","input":"0 0\n","expectedOutput":"0\n","label":"Zero values"}],"starterCode":{"python":"import sys\n\ndef solve():\n    line = sys.stdin.read().split()\n    if not line:\n        return\n    a = int(line[0])\n    b = int(line[1])\n    # Print the sum of a and b\n    print(a + b)\n\nif __name__ == \"__main__\":\n    solve()\n","cpp":"#include <iostream>\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    long long a, b;\n    if (cin >> a >> b) {\n        cout << a + b << \"\\n\";\n    }\n    return 0;\n}\n","java":"import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNextLong()) {\n            long a = sc.nextLong();\n            long b = sc.nextLong();\n            System.out.println(a + b);\n        }\n    }\n}\n","javascript":"'use strict';\nconst fs = require('fs');\n\nfunction solve() {\n    const input = fs.readFileSync(0, 'utf8').trim();\n    if (!input) return;\n    const tokens = input.split(/\\s+/);\n    const a = BigInt(tokens[0]);\n    const b = BigInt(tokens[1]);\n    console.log((a + b).toString());\n}\n\nsolve();\n"},"timeLimitMs":2000,"memoryLimitMb":256,"hiddenTests":[{"id":"h1","input":"1000000000 1000000000\n","expectedOutput":"2000000000\n","isHidden":true},{"id":"h2","input":"-1000000000 -1000000000\n","expectedOutput":"-2000000000\n","isHidden":true},{"id":"h3","input":"-500 500\n","expectedOutput":"0\n","isHidden":true},{"id":"h4","input":"42 -100\n","expectedOutput":"-58\n","isHidden":true}]},"01-input-output-002":{"id":"01-input-output-002","topicId":"01-input-output","topicTitle":"Input & Output","order":2,"title":"Echo Line with Prefix","difficulty":"Easy","progressionStage":"Foundation","tags":["Input/Output","String Basics"],"executionType":"stdin","description":"Read a line of text containing a user name and print \"Hello, <name>!\" to standard output.","inputFormat":"A single non-empty line of text representing the name.","outputFormat":"Print \"Hello, <name>!\".","constraints":["1 <= |name| <= 100","The name consists of alphanumeric characters."],"examples":[{"input":"Genesis","output":"Hello, Genesis!","explanation":"The output greets Genesis."},{"input":"Alice","output":"Hello, Alice!","explanation":"The output greets Alice."}],"visibleTests":[{"id":"v1","input":"Genesis\n","expectedOutput":"Hello, Genesis!\n","label":"Example 1"},{"id":"v2","input":"Alice\n","expectedOutput":"Hello, Alice!\n","label":"Example 2"}],"starterCode":{"python":"import sys\n\ndef solve():\n    name = sys.stdin.read().strip()\n    if name:\n        print(f\"Hello, {name}!\")\n\nif __name__ == \"__main__\":\n    solve()\n","cpp":"#include <iostream>\n#include <string>\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    string s;\n    if (cin >> s) {\n        cout << \"Hello, \" << s << \"!\\n\";\n    }\n    return 0;\n}\n","java":"import java.util.Scanner;\n\npublic class Main {\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        if (sc.hasNext()) {\n            String s = sc.next();\n            System.out.println(\"Hello, \" + s + \"!\");\n        }\n    }\n}\n","javascript":"'use strict';\nconst fs = require('fs');\n\nfunction solve() {\n    const input = fs.readFileSync(0, 'utf8').trim();\n    if (!input) return;\n    console.log('Hello, ' + input.split(/\\s+/)[0] + '!');\n}\n\nsolve();\n"},"timeLimitMs":2000,"memoryLimitMb":256,"hiddenTests":[{"id":"h1","input":"World\n","expectedOutput":"Hello, World!\n","isHidden":true},{"id":"h2","input":"Developer\n","expectedOutput":"Hello, Developer!\n","isHidden":true},{"id":"h3","input":"Zensus2026\n","expectedOutput":"Hello, Zensus2026!\n","isHidden":true}]},"01-input-output-003":{"id":"01-input-output-003","topicId":"01-input-output","topicTitle":"Input & Output","order":3,"title":"Buffer Line Inversion","difficulty":"Easy","progressionStage":"Foundation","tags":["Input & Output","Stage-1"],"executionType":"stdin","description":"Given input parameters for buffer line inversion, compute and print the required algorithmic output according to the problem constraints. Read inputs from standard input and write the exact output to standard output.","inputFormat":"The input consists of space-separated tokens corresponding to test case parameters.","outputFormat":"Print the computed result on a single line.","constraints":["1 <= N <= 100000","-10^9 <= A[i] <= 10^9"],"examples":[{"input":"23 8","output":"31","explanation":"For input (23 8), the computed result is 31."},{"input":"46 24","output":"70","explanation":"For input (46 24), the computed result is 70."}],"visibleTests":[{"id":"v1","input":"23 8\n","expectedOutput":"31\n","label":"Sample 1"},{"id":"v2","input":"46 24\n","expectedOutput":"70\n","label":"Sample 2"}],"starterCode":{"python":"import sys\n\ndef solve():\n    # Read standard input\n    input_data = sys.stdin.read().split()\n    if not input_data:\n        return\n    \n    # Write your solution here\n    pass\n\nif __name__ == \"__main__\":\n    solve()\n","cpp":"#include <iostream>\n#include <vector>\n#include <string>\n#include <algorithm>\n\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n\n    // Read input and write solution here\n\n    return 0;\n}\n","java":"import java.io.*;\nimport java.util.*;\n\npublic class Main {\n    public static void main(String[] args) throws Exception {\n        Scanner sc = new Scanner(System.in);\n        // Read input and write solution here\n    }\n}\n","javascript":"'use strict';\n\nconst fs = require('fs');\n\nfunction solve() {\n    const input = fs.readFileSync(0, 'utf8').trim();\n    if (!input) return;\n    cons