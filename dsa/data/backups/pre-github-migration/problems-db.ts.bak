    visibleTests: [
      { id: 'v1', input: '5 7\n', expectedOutput: '12\n', label: 'Example 1' },
      { id: 'v2', input: '-3 8\n', expectedOutput: '5\n', label: 'Example 2' },
      { id: 'v3', input: '0 0\n', expectedOutput: '0\n', label: 'Zero values' },
