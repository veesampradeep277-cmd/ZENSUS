      { id: 'v2', input: '0\n\n', expectedOutput: '0\n', label: 'Empty List' },
    ],
    hiddenTests: [
      { id: 'h1', input: '1\n100\n', expectedOutput: '1\n', isHidden: true },
      { id: 'h2', input: '5\n10 20 30 40 50\n', expectedOutput: '5\n', isHidden: true },
    ],
