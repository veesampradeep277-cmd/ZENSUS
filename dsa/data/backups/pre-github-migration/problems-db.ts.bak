  // Stack
  '14-stack-001': {
    title: 'Valid Parentheses String',
    difficulty: 'Easy',
    order: 1,
    progressionStage: 'Foundation',
    tags: ['Stack', 'Matching', 'Strings'],
    description: 'Given a string $S$ containing just the characters "(", ")", "{", "}", "[" and "]", determine if the input string is valid. An input string is valid if open brackets are closed by the same type of brackets in the correct order. Output "YES" if valid, otherwise "NO".',
    inputFormat: 'A single string $S$ containing brackets.',
    outputFormat: 'Print "YES" if valid, else "NO".',
    constraints: ['1 <= |S| <= 100000', 'S consists only of ()[]{} brackets.'],
    examples: [
      { input: '()[]{}', output: 'YES', explanation: 'All brackets match correctly.' },
      { input: '(]', output: 'NO', explanation: 'Round open bracket closed by square bracket.' },
    ],
    visibleTests: [
      { id: 'v1', input: '()[]{}\n', expectedOutput: 'YES\n', label: 'All Pairs' },
      { id: 'v2', input: '(]\n', expectedOutput: 'NO\n', label: 'Mismatched' },
      { id: 'v3', input: '([{}])\n', expectedOutput: 'YES\n', label: 'Nested' },
    ],
    hiddenTests: [
      { id: 'h1', input: '(\n', expectedOutput: 'NO\n', isHidden: true },
      { id: 'h2', input: ']\n', expectedOutput: 'NO\n', isHidden: true },
      { id: 'h3', input: '((()))\n', expectedOutput: 'YES\n', isHidden: true },
      { id: 'h4', input: '[(])\n', expectedOutput: 'NO\n', isHidden: true },
    ],
    starterCode: {
      python: `import sys

def solve():
    s = sys.stdin.read().strip()
    if not s:
        print("YES")
        return
    stack = []
    mapping = {')': '(', '}': '{', ']': '['}
    for char in s:
        if char in mapping:
            top = stack.pop() if stack else '#'
            if mapping[char] != top:
                print("NO")
                return
        else:
            stack.append(char)
    print("YES" if not stack else "NO")

if __name__ == "__main__":
    solve()
`,
      cpp: `#include <iostream>
#include <string>
#include <stack>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    string s;
    if (cin >> s) {
        stack<char> st;
        bool ok = true;
        for (char c : s) {
            if (c == '(' || c == '{' || c == '[') st.push(c);
            else {
                if (st.empty()) { ok = false; break; }
                char top = st.top(); st.pop();
                if (c == ')' && top != '(') { ok = false; break; }
                if (c == '}' && top != '{') { ok = false; break; }
                if (c == ']' && top != '[') { ok = false; break; }
            }
        }
        if (!st.empty()) ok = false;
        cout << (ok ? "YES" : "NO") << "\\n";
    }
    return 0;
}
`,
      java: `import java.util.Scanner;
import java.util.Stack;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        if (sc.hasNext()) {
            String s = sc.next();
            Stack<Character> st = new Stack<>();
            boolean ok = true;
            for (char c : s.toCharArray()) {
                if (c == '(' || c == '{' || c == '[') st.push(c);
                else {
                    if (st.isEmpty()) { ok = false; break; }
                    char top = st.pop();
                    if (c == ')' && top != '(') { ok = false; break; }
                    if (c == '}' && top != '{') { ok = false; break; }
                    if (c == ']' && top != '[') { ok = false; break; }
                }
            }
            if (!st.isEmpty()) ok = false;
            System.out.println(ok ? "YES" : "NO");
        }
    }
}
`,
      javascript: `'use strict';
const fs = require('fs');

function solve() {
    const s = fs.readFileSync(0, 'utf8').trim();
    if (!s) { console.log('YES'); return; }
    const map = { ')': '(', '}': '{', ']': '[' };
    const stack = [];
    for (let c of s) {
        if (c in map) {
            if (stack.length === 0 || stack.pop() !== map[c]) {
                console.log('NO');
                return;
            }
        } else {
            stack.push(c);
        }
    }
    console.log(stack.length === 0 ? 'YES' : 'NO');
}

solve();
`,
    },
  },

  // Binary Search
  '18-binary-search-001': {
    title: 'Binary Search in Sorted Array',
    difficulty: 'Easy',
    order: 1,
    progressionStage: 'Foundation',
    tags: ['Binary Search', 'Divide and Conquer'],
    description: 'Given a sorted array $A$ of $N$ distinct integers in ascending order and a target value $K$, write a function to search $K$ in $A$. If $K$ exists, return its 0-based index. Otherwise, print -1. Your solution must run in $O(\\log N)$ runtime complexity.',
    inputFormat: 'First line contains two integers $N$ and $K$. Second line contains $N$ sorted integers.',
    outputFormat: 'Print the 0-based index of $K$ in array $A$, or -1 if $K$ is not found.',
    constraints: ['1 <= N <= 100000', '-10^9 <= A[i], K <= 10^9', 'All elements in A are strictly ascending.'],
    examples: [
      { input: '6 9\n-1 0 3 5 9 12', output: '4', explanation: '9 exists in A and its index is 4.' },
      { input: '6 2\n-1 0 3 5 9 12', output: '-1', explanation: '2 does not exist in A so return -1.' },
    ],
    visibleTests: [
      { id: 'v1', input: '6 9\n-1 0 3 5 9 12\n', expectedOutput: '4\n', label: 'Present' },
      { id: 'v2', input: '6 2\n-1 0 3 5 9 12\n', expectedOutput: '-1\n', label: 'Absent' },
    ],
    hiddenTests: [
      { id: 'h1', input: '1 5\n5\n', expectedOutput: '0\n', isHidden: true },
      { id: 'h2', input: '1 3\n5\n', expectedOutput: '-1\n', isHidden: true },
      { id: 'h3', input: '5 100\n10 20 30 40 100\n', expectedOutput: '4\n', isHidden: true },
      { id: 'h4', input: '5 10\n10 20 30 40 100\n', expectedOutput: '0\n', isHidden: true },
    ],
    starterCode: {
      python: `import sys

def solve():
    tokens = sys.stdin.read().split()
    if not tokens:
        return
    n = int(tokens[0])
    k = int(tokens[1])
    arr = [int(x) for x in tokens[2:2+n]]
    
    l, r = 0, n - 1
    ans = -1
    while l <= r:
        mid = (l + r) // 2
        if arr[mid] == k:
            ans = mid
            break
        elif arr[mid] < k:
            l = mid + 1
        else:
            r = mid - 1
            
    print(ans)

if __name__ == "__main__":
    solve()
`,
      cpp: `#include <iostream>
#include <vector>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    long long k;
    if (cin >> n >> k) {
        vector<long long> arr(n);
        for (int i = 0; i < n; i++) cin >> arr[i];

        int l = 0, r = n - 1, ans = -1;
        while (l <= r) {
            int mid = l + (r - l) / 2;
            if (arr[mid] == k) { ans = mid; break; }
            else if (arr[mid] < k) l = mid + 1;
            else r = mid - 1;
        }
        cout << ans << "\\n";
    }
    return 0;
}
`,
      java: `import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        if (sc.hasNextInt()) {
            int n = sc.nextInt();
            long k = sc.nextLong();
            long[] arr = new long[n];
            for (int i = 0; i < n; i++) arr[i] = sc.nextLong();

            int l = 0, r = n - 1, ans = -1;
            while (l <= r) {
                int mid = l + (r - l) / 2;
                if (arr[mid] == k) { ans = mid; break; }
                else if (arr[mid] < k) l = mid + 1;
                else r = mid - 1;
            }
            System.out.println(ans);
        }
    }
}
`,
      javascript: `'use strict';
const fs = require('fs');

function solve() {
    const input = fs.readFileSync(0, 'utf8').trim();
    if (!input) return;
    const tokens = input.split(/\\s+/);
    const n = parseInt(tokens[0], 10);
    const k = BigInt(tokens[1]);
    const arr = tokens.slice(2, 2 + n).map(x => BigInt(x));

    let l = 0, r = n - 1, ans = -1;
    while (l <= r) {
        const mid = Math.floor((l + r) / 2);
        if (arr[mid] === k) { ans = mid; break; }
        else if (arr[mid] < k) l = mid + 1;
        else r = mid - 1;
    }
    console.log(ans);
}

solve();
`,
    },
  },
};

// Algorithmic pattern blueprints per topic to generate realistic problems
function getCurriculumPattern(topicNumber: number, order: number): {
  title: string;
  tags: string[];
  description: string;
  inputFormat: string;
  outputFormat: string;
  constraints: string[];
  examples: Array<{ input: string; output: string; explanation?: string }>;
  visibleTests: Array<{ id: string; input: string; expectedOutput: string; label?: string }>;
  hiddenTests: TestCase[];
  status: 'draft';
  isDraft: boolean;
} {
  // Realistic title and context based on topic
  const topicTitles: Record<number, string[]> = {
    1: ['Stream Token Sum', 'Format Number Matrix', 'Buffer Line Inversion', 'Delimiter Splitter', 'Character Frequency Echo'],
    2: ['Modular Exponentiation', 'Greatest Common Divisor', 'Prime Sieve Query', 'Fibonacci Sequence Term', 'Catalan Number Computation'],
    3: ['Kadane Max Subarray', 'Rotate Array Left', 'Dutch National Flag Partition', 'Merge Two Sorted Arrays', 'Subarray Sum Equals Target'],
    4: ['Longest Common Prefix', 'Anagram Grouping', 'String Compression Run', 'Valid Anagram Check', 'Longest Substring Without Repeat'],
    5: ['Subarray with Sum Zero', 'Longest Consecutive Chain', 'Count Distinct in Window', 'Pair with Target Sum', 'First Unique Element'],
    6: ['Merge Sort Implement', 'Quick Sort Median Pivot', 'Sort Array by Frequency', 'Inversion Count Array', 'Sort Colors Three Way'],
    7: ['Peak Element Index', 'Square Root Floor', 'Search in Rotated Sorted', 'Find Minimum in Rotated', 'Aggressive Cows Placement'],
    8: ['Two Sum Sorted', '3Sum Triplet Target', 'Container With Most Water', 'Trapping Rain Water', 'Remove Duplicates In Place'],
    9: ['Max Sum Subarray Size K', 'Longest Substring K Distinct', 'Fruit Into Baskets', 'Subarray Product Less Than K', 'Minimum Window Substring'],
    10: ['Range Sum Query Immutable', 'Equilibrium Index Pivot', 'Continuous Subarray Sum', 'Subarray Sum Divisible by K', 'Matrix Block Sum 2D'],
    11: ['Tower of Hanoi Moves', 'Power Function X to N', 'Combination Sum Generator', 'Josephus Problem Survivor', 'Permutation Sequence K'],
    12: ['N-Queens Safe Boards', 'Sudoku Board Solver', 'Rat in a Maze Paths', 'Word Search Grid', 'Partition to K Equal Sums'],
    13: ['Reverse Singly Linked List', 'Detect Cycle Floyd Tortoise', 'Merge Two Sorted Lists', 'Remove Nth Node from End', 'Add Two Numbers Linked'],
    14: ['Next Greater Element I', 'Min Stack Constant Time', 'Evaluate Reverse Polish Notation', 'Daily Temperatures Ahead', 'Largest Rectangle Histogram'],
    15: ['Implement Queue with Stacks', 'Design Circular Queue', 'First Unique Char in Stream', 'Sliding Window Queue', 'Task Scheduler Cooldown'],
    16: ['Sliding Window Maximum', 'Design Double Ended Queue', 'Shortest Subarray Sum at Least K', 'Max of Min for Every Window Size', 'Palindrome Deque Verify'],
    17: ['Next Greater Element II Circular', 'Online Stock Span', 'Sum of Subarray Minimums', 'Maximal Rectangle in Matrix', 'Remove K Digits Minimum'],
    18: ['Search in Sorted 2D Matrix', 'Koko Eating Bananas Speed', 'Capacity to Ship Packages', 'Median of Two Sorted Arrays', 'Split Array Largest Sum'],
    19: ['Single Number Non-Repeating', 'Number of 1 Bits Hamming', 'Counting Bits DP', 'Reverse Bits 32-bit', 'Bitwise AND of Numbers Range'],
    20: ['Activity Selection Interval', 'Jump Game Min Steps', 'Gas Station Circuit Tour', 'Assign Cookies Greedy', 'Candy Distribution Kids'],
    21: ['Merge Overlapping Intervals', 'Insert Interval Coordinate', 'Non-overlapping Intervals Min', 'Meeting Rooms Maximum Parallel', 'Interval List Intersections'],
    22: ['Kth Largest in Array', 'Merge K Sorted Lists Heap', 'Find Median from Data Stream', 'Top K Frequent Elements', 'Task Scheduler Priority'],
    23: ['LRU Cache Eviction Policy', 'LFU Cache Frequency Tie', 'Insert Delete GetRandom O(1)', 'Subarray Sum Multi-Set', 'Design Underground System'],
    24: ['Maximum Depth of Binary Tree', 'Diameter of Binary Tree', 'Invert Binary Tree In-place', 'Path Sum Root to Leaf', 'Lowest Common Ancestor BT'],
    25: ['Validate Binary Search Tree', 'Search in Binary Search Tree', 'Lowest Common Ancestor BST', 'Kth Smallest Element in BST', 'Delete Node in BST'],
    26: ['Binary Tree Level Order Traversal', 'Binary Tree Zigzag Order', 'Vertical Order Traversal', 'Binary Tree Inorder Iterative', 'Boundary Traversal Binary Tree'],
    27: ['Implement Trie Prefix Tree', 'Search Suggestions System', 'Maximum XOR of Two Numbers', 'Word Search II Trie Grid', 'Replace Words with Root'],
    28: ['Binary Tree Maximum Path Sum', 'Serialize and Deserialize Tree', 'Distribute Coins in Tree', 'Flatten Binary Tree to Linked List', 'All Nodes Distance K in Tree'],
    29: ['Number of Connected Components', 'Bipartite Graph 2-Coloring', 'Detect Cycle in Undirected Graph', 'Clone Graph BFS', 'Graph Valid Tree Test'],
    30: ['Number of Islands Grid', 'Rotting Oranges Multisource BFS', 'Word Ladder Shortest Path', 'Surrounded Regions Capture', 'Pacific Atlantic Water Flow'],
    31: ['Course Schedule I Prerequisites', 'Course Schedule II Order', 'Alien Dictionary Lexicographical', 'Sequence Reconstruction Unique', 'Parallel Courses Semesters'],
    32: ['Dijkstra Single Source Shortest', 'Cheapest Flights Within K Stops', 'Network Delay Time', 'Bellman Ford Negative Cycles', 'Floyd Warshall All Pairs'],
    33: ['Min Cost to Connect All Points', 'Kruskal Minimum Spanning Tree', 'Prim Minimum Spanning Tree', 'Connecting Cities Min Cost', 'Optimize Water Distribution'],
    34: ['Redundant Connection DSU', 'Accounts Merge Emails', 'Number of Provinces', 'Smallest String With Swaps', 'Graph Connectivity Queries'],
    35: ['Climbing Stairs Ways', 'House Robber Max Loot', 'Coin Change Fewest Coins', 'Longest Increasing Subsequence', 'Partition Equal Subset Sum'],
    36: ['Unique Paths Grid', 'Longest Common Subsequence', 'Edit Distance Operations', '0-1 Knapsack Classic', 'Target Sum Ways DP'],
    37: ['Burst Balloons Range DP', 'Regular Expression Matching', 'Wildcard Matching DP', 'Digit DP Count Valid', 'Max Profit Job Scheduling'],
    38: ['Range Sum Query Segment Tree', 'Range Minimum Query RMQ', 'Lazy Propagation Segment Tree', 'Count of Smaller Numbers After Self', 'Fenwick Tree Binary Indexed'],
    39: ['Bridges in Graph Tarjan', 'Articulation Points Cut Vertices', 'Strongly Connected Components Kosaraju', 'Critical Connections Network', 'Max Flow Dinic Algorithm'],
    40: ['KMP Pattern Search Needle', 'Longest Happy Prefix KMP', 'Repeated Substring Pattern', 'Shortest Palindrome Prefix', 'Z-Algorithm String Matches'],
    41: ['Design Twitter Timeline', 'Trapping Rain Water II 2D', 'Median of Running Numbers', 'Sliding Window Median Hard', 'Minimum Window Subsequence'],
  };

  const list = topicTitles[topicNumber] || ['Algorithmic Optimization', 'Sequential Scan', 'Optimal Pathing', 'Window Maximizer', 'Dynamic Subset Sum'];
  const baseTitle = list[(order - 1) % list.length];
  const problemTitle = `${baseTitle} ${order > 5 ? `(Variant ${Math.floor(order / 5)})` : ''}`.trim();
  const topicName = DSA_TOPICS_CONFIG.find(t => t.number === topicNumber)?.title || 'DSA';

  return {
    title: problemTitle,
    tags: [topicName, `Stage-${Math.min(5, Math.ceil(order / 15))}`, 'Draft'],
    status: 'draft',
    isDraft: true,
    description: `This problem (${problemTitle}) is currently in draft status and under curriculum development. The official problem statement, algorithmic specifications, and test cases have not yet been published.`,
    inputFormat: 'Curriculum specification pending publication.',
    outputFormat: 'Curriculum specification pending publication.',
    constraints: ['Curriculum specification in progress — code execution disabled for draft problems.'],
    examples: [
      {
        input: 'N/A',
        output: 'N/A',
        explanation: 'This problem is in draft status. Official examples and test suites will be provided upon publication.',
      },
    ],
    visibleTests: [],
    hiddenTests: [],
  };
}

class ProblemDatabase {
  private problems: Map<string, InternalProblemDefinition> = new Map();
  private topicProblemMap: Map<string, string[]> = new Map();

  constructor() {
    this.seedDatabase();
  }

  private seedDatabase() {
    // Generate all 41 topics × 75 problems = 3,075 problems
    for (const topic of DSA_TOPICS_CONFIG) {
      const topicProblemIds: string[] = [];
      const topicId = topic.id;

      for (let order = 1; order <= 75; order++) {
        const orderPadded = String(order).padStart(3, '0');
        const problemId = `${topicId}-${orderPadded}`;
        topicProblemIds.push(problemId);

        // Progression stages: 1-15 Foundation, 16-30 Basic Application, 31-45 Intermediate, 46-60 Advanced, 61-75 Interview
        let progressionStage: 'Foundation' | 'Basic Application' | 'Intermediate' | 'Advanced' | 'Interview / Placement' = 'Foundation';
        if (order <= 15) progressionStage = 'Foundation';
        else if (order <= 30) progressionStage = 'Basic Application';
        else if (order <= 45) progressionStage = 'Intermediate';
        else if (order <= 60) progressionStage = 'Advanced';
        else progressionStage = 'Interview / Placement';

        // Difficulty distribution: 25 Easy (1-25), 35 Medium (26-60), 15 Hard (61-75)
        let difficulty: Difficulty = 'Easy';
        if (order <= 25) difficulty = 'Easy';
        else if (order <= 60) difficulty = 'Medium';
        else difficulty = 'Hard';

        // Check if we have handcrafted or modular topic problem definition
        const handcrafted = HANDCRAFTED_PROBLEMS[problemId] || TOPIC_19_PROBLEMS[problemId];
        if (handcrafted) {
          const fullDef: InternalProblemDefinition = {
            id: problemId,
            topicId,
            topicTitle: topic.title,
            order,
            title: handcrafted.title || `Problem ${order}`,
            difficulty: difficulty,
            progressionStage: (handcrafted as any).progressionStage || progressionStage,
            tags: handcrafted.tags || [topic.title],
            executionType: handcrafted.executionType || 'stdin',
            status: handcrafted.status || 'published',
            isDraft: handcrafted.isDraft !== undefined ? handcrafted.isDraft : false,
            description: handcrafted.description || '',
            inputFormat: handcrafted.inputFormat || '',
            outputFormat: handcrafted.outputFormat || '',
            constraints: handcrafted.constraints || ['1 <= N <= 100000'],
            examples: handcrafted.examples || [],
            visibleTests: handcrafted.visibleTests || [],
            hiddenTests: handcrafted.hiddenTests || [],
            starterCode: handcrafted.starterCode || generateStarterCode(handcrafted.title || `Problem ${order}`),
            timeLimitMs: handcrafted.timeLimitMs || 2000,
            memoryLimitMb: handcrafted.memoryLimitMb || 256,
          };
          this.problems.set(problemId, fullDef);
        } else {
          // Generate draft curriculum placeholder problem
          const pattern = getCurriculumPattern(topic.number, order);
          const fullDef: InternalProblemDefinition = {
            id: problemId,
            topicId,
            topicTitle: topic.title,
            order,
            title: pattern.title,
            difficulty,
            progressionStage,
            tags: pattern.tags,
            executionType: 'stdin',
            status: 'draft',
            isDraft: true,
            description: pattern.description,
            inputFormat: pattern.inputFormat,
            outputFormat: pattern.outputFormat,
            constraints: pattern.constraints,
            examples: pattern.examples,
            visibleTests: pattern.visibleTests,
            hiddenTests: pattern.hiddenTests,
            starterCode: {
              python: `# [Draft] ${pattern.title}\n# This problem is currently under curriculum authoring.\n# Code execution and submission are disabled until publication.\n`,
              cpp: `// [Draft] ${pattern.title}\n// This problem is currently under curriculum authoring.\n// Code execution and submission are disabled until publication.\nint main() { return 0; }\n`,
              java: `// [Draft] ${pattern.title}\n// This problem is currently under curriculum authoring.\n// Code execution and submission are disabled until publication.\npublic class Main { public static void main(String[] args) {} }\n`,
              javascript: `// [Draft] ${pattern.title}\n// This problem is currently under curriculum authoring.\n// Code execution and submission are disabled until publication.\n`,
            },
            timeLimitMs: 2000,
            memoryLimitMb: 256,
          };
          this.problems.set(problemId, fullDef);
        }
      }

      this.topicProblemMap.set(topicId, topicProblemIds);
    }
  }

  getAllTopics(): typeof DSA_TOPICS_CONFIG {
    return DSA_TOPICS_CONFIG;
  }

  getTopicById(topicId: string) {
    return DSA_TOPICS_CONFIG.find(t => t.id === topicId || t.slug === topicId);
  }

  getProblemsByTopic(topicId: string): ProblemSummary[] {
    const topic = this.getTopicById(topicId);
    if (!topic) return [];
    const ids = this.topicProblemMap.get(topic.id) || [];
    return ids.map(id => {
      const p = this.problems.get(id)!;
      return {
        id: p.id,
        topicId: p.topicId,
        topicTitle: p.topicTitle,
        order: p.order,
        title: p.title,
        difficulty: p.difficulty,
        progressionStage: p.progressionStage,
        tags: p.tags,
        executionType: p.executionType,
        status: p.status,
        isDraft: p.isDraft,
      };
    });
  }

  /**
   * Returns sanitized problem for student frontend.
   * NEVER exposes hidden tests, reference solutions, or judge secrets!
   */
  getPublicProblemById(problemId: string): ProblemDetail | null {
    const p = this.problems.get(problemId);
    if (!p) return null;

    return {
      id: p.id,
      topicId: p.topicId,
      topicTitle: p.topicTitle,
      order: p.order,
      title: p.title,
      difficulty: p.difficulty,
      progressionStage: p.progressionStage,
      tags: p.tags,
      executionType: p.executionType,
      status: p.status,
      isDraft: p.isDraft,
      description: p.description,
      inputFormat: p.inputFormat,
      outputFormat: p.outputFormat,
      constraints: p.constraints,
      examples: p.examples,
      visibleTests: p.visibleTests,
      starterCode: p.starterCode,
      timeLimitMs: p.timeLimitMs,
      memoryLimitMb: p.memoryLimitMb,
    };
  }

  /**
   * Internal method for Judge Service only.
   */
  getInternalProblemById(problemId: string): InternalProblemDefinition | null {
    return this.problems.get(problemId) || null;
  }

  getTotalProblemsCount(): number {
    return this.problems.size;
  }
}

export const problemDatabase = new ProblemDatabase();
