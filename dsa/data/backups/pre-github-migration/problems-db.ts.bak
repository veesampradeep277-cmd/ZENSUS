  // Arrays
  '03-arrays-001': {
    title: 'Find the Largest Element',
    difficulty: 'Easy',
    order: 1,
    progressionStage: 'Foundation',
    tags: ['Arrays', 'Traversal', 'Linear Scan'],
    description: 'Given an array $A$ of $N$ integers, find and print the maximum element in the array.',
    inputFormat: 'The first line contains integer $N$. The second line contains $N$ space-separated integers $A[0], A[1], \\dots, A[N-1]$.',
    outputFormat: 'Print the largest integer present in the array.',
    constraints: ['1 <= N <= 100000', '-10^9 <= A[i] <= 10^9'],
    examples: [
      { input: '5\n1 8 7 56 90', output: '90', explanation: '90 is the greatest integer in the array.' },
      { input: '4\n-10 -5 -20 -1', output: '-1', explanation: '-1 is the greatest integer in the negative array.' },
    ],
    visibleTests: [
      { id: 'v1', input: '5\n1 8 7 56 90\n', expectedOutput: '90\n', label: 'Example 1' },
      { id: 'v2', input: '4\n-10 -5 -20 -1\n', expectedOutput: '-1\n', label: 'Negative Numbers' },
      { id: 'v3', input: '1\n42\n', expectedOutput: '42\n', label: 'Single Element' },
    ],
    hiddenTests: [
      { id: 'h1', input: '6\n100 200 50 400 300 250\n', expectedOutput: '400\n', isHidden: true },
      { id: 'h2', input: '5\n-999999999 -888888888 -777777777 -1000000000 -666666666\n', expectedOutput: '-666666666\n', isHidden: true },
      { id: 'h3', input: '7\n0 0 0 0 0 0 0\n', expectedOutput: '0\n', isHidden: true },
      { id: 'h4', input: '4\n10 10 10 10\n', expectedOutput: '10\n', isHidden: true },
    ],
    starterCode: {
      python: `import sys

def solve():
    tokens = sys.stdin.read().split()
    if not tokens:
        return
    n = int(tokens[0])
    arr = [int(x) for x in tokens[1:n+1]]
    
    # Write code to find and print the maximum element
    max_val = max(arr)
    print(max_val)

if __name__ == "__main__":
    solve()
`,
      cpp: `#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    if (cin >> n) {
        vector<long long> arr(n);
        for (int i = 0; i < n; i++) cin >> arr[i];
        
        long long max_val = arr[0];
        for (int i = 1; i < n; i++) {
            if (arr[i] > max_val) max_val = arr[i];
        }
        cout << max_val << "\\n";
    }
    return 0;
}
`,
      java: `import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        if (sc.hasNextInt()) {
            int n = sc.nextInt();
            long maxVal = sc.nextLong();
            for (int i = 1; i < n; i++) {
                long val = sc.nextLong();
                if (val > maxVal) maxVal = val;
            }
            System.out.println(maxVal);
        }
    }
}
`,
      javascript: `'use strict';
const fs = require('fs');

function solve() {
    const input = fs.readFileSync(0, 'utf8').trim();
    if (!input) return;
    const tokens = input.split(/\\s+/);
    const n = parseInt(tokens[0], 10);
    let maxVal = BigInt(tokens[1]);
    for (let i = 2; i <= n; i++) {
        const val = BigInt(tokens[i]);
        if (val > maxVal) maxVal = val;
    }
    console.log(maxVal.toString());
}

solve();
`,
    },
  },

  '03-arrays-002': {
    title: 'Reverse an Array',
    difficulty: 'Easy',
    order: 2,
    progressionStage: 'Foundation',
    tags: ['Arrays', 'Two Pointers', 'In-place'],
    description: 'Given an array $A$ of $N$ integers, reverse the array in place and print the reversed elements.',
    inputFormat: 'First line contains integer $N$. Second line contains $N$ space-separated integers.',
    outputFormat: 'Print the elements in reversed order, separated by spaces.',
    constraints: ['1 <= N <= 100000', '-10^9 <= A[i] <= 10^9'],
    examples: [
      { input: '4\n1 2 3 4', output: '4 3 2 1', explanation: 'Reversing [1, 2, 3, 4] gives [4, 3, 2, 1].' },
      { input: '3\n10 20 30', output: '30 20 10', explanation: 'Reversing [10, 20, 30] gives [30, 20, 10].' },
    ],
    visibleTests: [
      { id: 'v1', input: '4\n1 2 3 4\n', expectedOutput: '4 3 2 1\n', label: 'Example 1' },
      { id: 'v2', input: '3\n10 20 30\n', expectedOutput: '30 20 10\n', label: 'Example 2' },
      { id: 'v3', input: '1\n99\n', expectedOutput: '99\n', label: 'Single Element' },
    ],
    hiddenTests: [
      { id: 'h1', input: '5\n5 4 3 2 1\n', expectedOutput: '1 2 3 4 5\n', isHidden: true },
      { id: 'h2', input: '2\n-10 10\n', expectedOutput: '10 -10\n', isHidden: true },
      { id: 'h3', input: '6\n1 1 2 2 3 3\n', expectedOutput: '3 3 2 2 1 1\n', isHidden: true },
    ],
    starterCode: {
      python: `import sys

def solve():
    tokens = sys.stdin.read().split()
    if not tokens:
        return
    n = int(tokens[0])
    arr = tokens[1:n+1]
    
    # Reverse and print
    print(" ".join(reversed(arr)))

if __name__ == "__main__":
    solve()
`,
      cpp: `#include <iostream>
#include <vector>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    if (cin >> n) {
        vector<long long> arr(n);
        for (int i = 0; i < n; i++) cin >> arr[i];
        for (int i = n - 1; i >= 0; i--) {
            cout << arr[i] << (i == 0 ? "" : " ");
        }
        cout << "\\n";
    }
    return 0;
}
`,
      java: `import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        if (sc.hasNextInt()) {
            int n = sc.nextInt();
            long[] arr = new long[n];
            for (int i = 0; i < n; i++) arr[i] = sc.nextLong();
            for (int i = n - 1; i >= 0; i--) {
                System.out.print(arr[i] + (i == 0 ? "" : " "));
            }
            System.out.println();
        }
    }
}
`,
      javascript: `'use strict';
const fs = require('fs');

function solve() {
    const input = fs.readFileSync(0, 'utf8').trim();
    if (!input) return;
    const tokens = input.split(/\\s+/);
    const n = parseInt(tokens[0], 10);
    const arr = tokens.slice(1, n + 1);
    console.log(arr.reverse().join(' '));
}

solve();
`,
    },
  },

  // Strings
  '04-strings-001': {
    title: 'Palindrome String Check',
    difficulty: 'Easy',
    order: 1,
    progressionStage: 'Foundation',
    tags: ['Strings', 'Two Pointers'],
    description: 'Given a non-empty string $S$, determine if it is a palindrome. A string is a palindrome if it reads the same backward as forward. Output "YES" if it is a palindrome, otherwise "NO".',
    inputFormat: 'A single string $S$ containing lowercase English letters.',
    outputFormat: 'Print "YES" if the string is a palindrome, otherwise print "NO".',
    constraints: ['1 <= |S| <= 100000', 'S consists only of lowercase letters.'],
    examples: [
      { input: 'racecar', output: 'YES', explanation: '"racecar" spelled backwards is still "racecar".' },
      { input: 'genesis', output: 'NO', explanation: '"genesis" spelled backwards is "siseneg".' },
    ],
    visibleTests: [
      { id: 'v1', input: 'racecar\n', expectedOutput: 'YES\n', label: 'Odd Length' },
      { id: 'v2', input: 'genesis\n', expectedOutput: 'NO\n', label: 'Not Palindrome' },
      { id: 'v3', input: 'abba\n', expectedOutput: 'YES\n', label: 'Even Length' },
    ],
    hiddenTests: [
      { id: 'h1', input: 'a\n', expectedOutput: 'YES\n', isHidden: true },
      { id: 'h2', input: 'ab\n', expectedOutput: 'NO\n', isHidden: true },
      { id: 'h3', input: 'madam\n', expectedOutput: 'YES\n', isHidden: true },
      { id: 'h4', input: 'algorithmic\n', expectedOutput: 'NO\n', isHidden: true },
    ],
    starterCode: {
      python: `import sys

def solve():
    s = sys.stdin.read().strip()
    if not s:
        return
    if s == s[::-1]:
        print("YES")
    else:
        print("NO")

if __name__ == "__main__":
    solve()
`,
      cpp: `#include <iostream>
#include <string>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    string s;
    if (cin >> s) {
        bool ok = true;
        int l = 0, r = s.size() - 1;
        while (l < r) {
            if (s[l] != s[r]) { ok = false; break; }
            l++; r--;
        }
        cout << (ok ? "YES" : "NO") << "\\n";
    }
    return 0;
}
`,
      java: `import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        if (sc.hasNext()) {
            String s = sc.next();
            int l = 0, r = s.length() - 1;
            boolean ok = true;
            while (l < r) {
                if (s.charAt(l) != s.charAt(r)) { ok = false; break; }
                l++; r--;
            }
            System.out.println(ok ? "YES" : "NO");
        }
    }
}
`,
      javascript: `'use strict';
const fs = require('fs');

function solve() {
    const s = fs.readFileSync(0, 'utf8').trim();
    if (!s) return;
    const rev = s.split('').reverse().join('');
    console.log(s === rev ? 'YES' : 'NO');
}

solve();
`,
    },
  },

  '04-strings-002': {
    title: 'Count Vowels and Consonants',
    difficulty: 'Easy',
    order: 2,
    progressionStage: 'Foundation',
    tags: ['Strings', 'Frequency', 'Character Classification'],
    description: 'Given a lowercase string $S$, count the number of vowels (a, e, i, o, u) and consonants.',
    inputFormat: 'A single string $S$ containing lowercase English letters.',
    outputFormat: 'Print two space-separated integers: the count of vowels followed by the count of consonants.',
    constraints: ['1 <= |S| <= 100000', 'S consists only of lowercase letters.'],
    examples: [
      { input: 'hello', output: '2 3', explanation: 'Vowels: e, o (2). Consonants: h, l, l (3).' },
      { input: 'aeiou', output: '5 0', explanation: 'All characters are vowels.' },
    ],
    visibleTests: [
      { id: 'v1', input: 'hello\n', expectedOutput: '2 3\n', label: 'Example 1' },
      { id: 'v2', input: 'aeiou\n', expectedOutput: '5 0\n', label: 'All Vowels' },
    ],
    hiddenTests: [
      { id: 'h1', input: 'xyz\n', expectedOutput: '0 3\n', isHidden: true },
      { id: 'h2', input: 'datastructure\n', expectedOutput: '5 8\n', isHidden: true },
      { id: 'h3', input: 'a\n', expectedOutput: '1 0\n', isHidden: true },
    ],
    starterCode: {
      python: `import sys

def solve():
    s = sys.stdin.read().strip()
    if not s:
        return
    vowels = set('aeiou')
    v_count = sum(1 for c in s if c in vowels)
    c_count = len(s) - v_count
    print(f"{v_count} {c_count}")

if __name__ == "__main__":
    solve()
`,
      cpp: `#include <iostream>
#include <string>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    string s;
    if (cin >> s) {
        int v = 0, c = 0;
        for (char ch : s) {
            if (ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u') v++;
            else c++;
        }
        cout << v << " " << c << "\\n";
    }
    return 0;
}
`,
      java: `import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        if (sc.hasNext()) {
            String s = sc.next();
            int v = 0, c = 0;
            for (char ch : s.toCharArray()) {
                if ("aeiou".indexOf(ch) >= 0) v++;
                else c++;
            }
            System.out.println(v + " " + c);
        }
    }
}
`,
      javascript: `'use strict';
const fs = require('fs');

function solve() {
    const s = fs.readFileSync(0, 'utf8').trim();
    if (!s) return;
    const v = (s.match(/[aeiou]/g) || []).length;
    const c = s.length - v;
    console.log(v + ' ' + c);
}

solve();
`,
    },
  },

  // Searching
  '07-searching-001': {
    title: 'Linear Search Target',
    difficulty: 'Easy',
    order: 1,
    progressionStage: 'Foundation',
    tags: ['Searching', 'Linear Scan'],
    description: 'Given an array $A$ of $N$ integers and a target value $K$, find the 0-based index of the first occurrence of $K$. If $K$ is not present, print -1.',
    inputFormat: 'First line contains two integers $N$ and $K$. Second line contains $N$ space-separated integers.',
    outputFormat: 'Print the 0-based index of $K$, or -1 if not found.',
    constraints: ['1 <= N <= 100000', '-10^9 <= A[i], K <= 10^9'],
    examples: [
      { input: '5 7\n1 2 7 4 5', output: '2', explanation: '7 first appears at index 2.' },
      { input: '4 99\n1 2 3 4', output: '-1', explanation: '99 does not appear in the array.' },
    ],
    visibleTests: [
      { id: 'v1', input: '5 7\n1 2 7 4 5\n', expectedOutput: '2\n', label: 'Target Present' },
      { id: 'v2', input: '4 99\n1 2 3 4\n', expectedOutput: '-1\n', label: 'Target Absent' },
    ],
    hiddenTests: [
      { id: 'h1', input: '1 42\n42\n', expectedOutput: '0\n', isHidden: true },
      { id: 'h2', input: '6 10\n10 10 10 10 10 10\n', expectedOutput: '0\n', isHidden: true },
      { id: 'h3', input: '5 -5\n1 2 -5 4 -5\n', expectedOutput: '2\n', isHidden: true },
    ],
    starterCode: {
      python: `import sys

def solve():
    tokens = sys.stdin.read().split()
    if not tokens:
        return
    n = int(tokens[0])
    k = int(tokens[1])
    arr = [int(x) for x in tokens[2:2+n]]
    
    try:
        idx = arr.index(k)
        print(idx)
    except ValueError:
        print(-1)

if __name__ == "__main__":
    solve()
`,
      cpp: `#include <iostream>
#include <vector>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    long long k;
    if (cin >> n >> k) {
        int ans = -1;
        for (int i = 0; i < n; i++) {
            long long x;
            cin >> x;
            if (x == k && ans == -1) ans = i;
        }
        cout << ans << "\\n";
    }
    return 0;
}
`,
      java: `import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        if (sc.hasNextInt()) {
            int n = sc.nextInt();
            long k = sc.nextLong();
            int ans = -1;
            for (int i = 0; i < n; i++) {
                long x = sc.nextLong();
                if (x == k && ans == -1) ans = i;
            }
            System.out.println(ans);
        }
    }
}
`,
      javascript: `'use strict';
const fs = require('fs');

function solve() {
    const input = fs.readFileSync(0, 'utf8').trim();
    if (!input) return;
    const tokens = input.split(/\\s+/);
    const n = parseInt(tokens[0], 10);
    const k = tokens[1];
    let ans = -1;
    for (let i = 0; i < n; i++) {
        if (tokens[2 + i] === k) { ans = i; break; }
    }
    console.log(ans);
}

solve();
`,
