    outputFormat: 'Print a single integer representing $A + B$.',
    constraints: ['-10^9 <= A, B <= 10^9'],
    examples: [
      { input: '5 7', output: '12', explanation: '5 + 7 = 12' },
      { input: '-3 8', output: '5', explanation: '-3 + 8 = 5' },
